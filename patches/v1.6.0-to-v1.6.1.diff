+	for level, ids := range n.Neighbors {
+		if len(ids) == 0 {
+			continue
+		}
+		refs := make([]string, 0, len(ids))
+		for _, edge := range ids {
+			idx := int(edge.idx)
+			if idx >= 0 && idx < len(h.nodes) {
+				refs = append(refs, h.nodes[idx].ID)
+			}
+		}
+		cn.Neighbors[level] = refs
+	}
+	return cn
