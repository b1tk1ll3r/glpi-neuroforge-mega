+func csv(v string) []string {
+	seen := map[string]bool{}
+	out := []string{}
+	for _, x := range strings.Split(v, ",") {
+		x = strings.ToLower(strings.TrimSpace(x))
+		if x != "" && !seen[x] {
+			seen[x] = true
+			out = append(out, x)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
