+
+grep -q '^FROM ' services/agent/Dockerfile
+grep -q 'AS data-init' services/agent/Dockerfile
+grep -q '^FROM ' services/knowledge/Dockerfile
+
+echo "OK: Dockerfiles and repository workflows are present."
