+	}
+	for _, h := range hits {
+		if h.Memory.ID == oldID {
+			t.Fatal("superseded outcome leaked into active retrieval")
+		}
+	}
+	found := false
+	for _, h := range hits {
+		found = found || h.Memory.ID == newID
+	}
+	if !found {
+		t.Fatalf("corrected outcome not found; hits=%#v", hits)
+	}
+}
